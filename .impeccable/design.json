  "narrative": {
    "northStar": "The Secure Ledger",
    "overview": "Infisical Console is a working record of sensitive entries, not a second dashboard. It borrows the calm of a well-kept ledger: warm paper, ink, hairline rules, tabular numbers, and a dark spine that keeps the environment visible without competing with the task. The interface is intentionally quiet. Colour is a signal, not decoration.",
    "keyCharacteristics": [
      "Bone paper and deep forest ink; one green accent and one vermilion risk colour.",
      "Hairline rules and tonal layers instead of shadows and cards.",
      "An index-and-leaf layout: environment rail, secret index, and inspector.",
      "Monospace only for keys, values, paths, counts, and timestamps.",
      "Masked values, explicit reveal, deliberate deletion."
    ],
    "rules": [
      {
        "name": "The One Risk Colour Rule",
        "body": "Vermilion appears only on destructive actions, deletion, and destructive error states. It is never used for decoration or emphasis.",
        "section": "colors"
      },
      {
        "name": "The Paper Ground Rule",
        "body": "Large surfaces stay paper-toned. Depth comes from hairlines and one tonal step, not from a gradient.",
        "section": "colors"
      },
      {
        "name": "The Data Is Monospace Rule",
        "body": "Monospace is reserved for data and measurement. Never set prose, labels, or buttons in it.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "If a border can explain the relationship, do not add a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show project, environment, and path before any read, write, or delete.",
      "Do keep values masked at a fixed width until an explicit inline reveal.",
      "Do use hairlines and tonal steps for structure.",
      "Do use Hugeicons at one stroke weight and label every icon-only control."
    ],
    "donts": [
      "Don't use neon-on-black, glassmorphism, gradient text, or glow.",
      "Don't use border-left/right accents thicker than 1px on rows or cards.",
      "Don't put the main editor in a centered modal.",
      "Don't show or log a secret value without an explicit reveal/copy action."
    ]
  }
